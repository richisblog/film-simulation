{
  "name": "film-simulation",
  "private": true,
  "version": "0.1.0",
  "license": "CC-BY-NC-4.0",
  "type": "module",
  "scripts": {
    "assets:previews": "node scripts/generate-preview-luts.mjs",
    "assets:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name film-simulation --branch main",
    "preview": "vite preview",
    "test": "vitest run",
    "test:assets": "node --test scripts/preview-luts.test.mjs",
    "test:pwa-assets": "node --test scripts/pwa-assets.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "30.0.1",
    "sharp": "0.35.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.120.0"
  }
}
